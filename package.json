{
  "name": "@marvikomo/codelens-ai",
  "version": "1.0.0",
  "description": "AST-graph code analysis with Tree-sitter and Neo4j",
  "main": "dist/cli.js",
  "bin": {
    "codelens": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "analyze": "ts-node src/cli.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "neo4j:start": "docker-compose up -d neo4j",
    "neo4j:stop": "docker-compose stop neo4j",
    "prepublishOnly": "npm run build && npm test",
    "grammars:install": "npm install --legacy-peer-deps --no-save tree-sitter-python tree-sitter-go tree-sitter-rust tree-sitter-ruby tree-sitter-c-sharp tree-sitter-php tree-sitter-scala tree-sitter-groovy tree-sitter-c tree-sitter-cpp tree-sitter-objc tree-sitter-kotlin tree-sitter-swift tree-sitter-elixir tree-sitter-julia tree-sitter-powershell tree-sitter-ocaml tree-sitter-commonlisp tree-sitter-dm tree-sitter-bash",
    "test:languages": "NODE_OPTIONS=--experimental-vm-modules jest src/__tests__/language-configs.test.ts"
  },
  "keywords": [
    "code-analysis",
    "static-analysis",
    "ast",
    "tree-sitter",
    "neo4j",
    "graph-database",
    "knowledge-graph",
    "code-intelligence",
    "javascript",
    "typescript",
    "java",
    "polyglot",
    "python",
    "go",
    "rust",
    "csharp",
    "php",
    "ruby",
    "kotlin",
    "swift"
  ],
  "author": "CodeLens AI Contributors",
  "license": "MIT",
  "homepage": "https://github.com/marvikomo/code-lens-aI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marvikomo/code-lens-aI.git"
  },
  "bugs": {
    "url": "https://github.com/marvikomo/code-lens-aI/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.5.0",
    "graphlib": "^2.1.8",
    "neo4j-driver": "^5.28.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "codelens": {
    "optionalGrammars": [
      "tree-sitter-python",
      "tree-sitter-go",
      "tree-sitter-rust",
      "tree-sitter-ruby",
      "tree-sitter-c-sharp",
      "tree-sitter-php",
      "tree-sitter-scala",
      "tree-sitter-groovy",
      "tree-sitter-c",
      "tree-sitter-cpp",
      "tree-sitter-objc",
      "tree-sitter-kotlin",
      "tree-sitter-swift",
      "tree-sitter-elixir",
      "tree-sitter-julia",
      "tree-sitter-powershell",
      "tree-sitter-ocaml",
      "tree-sitter-commonlisp",
      "tree-sitter-dm",
      "tree-sitter-bash"
    ],
    "note": "Installed via `npm run grammars:install`. Kept out of dependencies because most of these packages still declare a tree-sitter ^0.21/^0.22 peer range, which makes a strict npm resolver fail the whole install; they load correctly against tree-sitter 0.25 at runtime. Any grammar that is absent costs only its own language."
  }
}
