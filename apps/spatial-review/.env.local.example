# Copy to .env.local and fill in.

# GitHub Personal Access Token (classic, with `repo` scope).
# Create at https://github.com/settings/tokens
# For the prototype we read this server-side and use it to list your repos
# and fetch PR data. OAuth replaces this in production.
GITHUB_TOKEN=

# Neo4j connection — same DB that `codelens index` writes to.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Optional. Defaults to the system database.
# NEO4J_DATABASE=
